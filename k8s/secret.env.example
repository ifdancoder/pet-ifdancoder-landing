# Copy to k8s/secret.env and fill in real values. k8s/secret.env is gitignored
# and never committed — kustomize turns it into the "landing-secret" Secret.
#
#   APP_KEY:     php artisan key:generate --show
#   DB_PASSWORD: any strong random string, shared with the postgres StatefulSet
#   ADMIN_PATH:  a non-guessable path for the Filament admin panel

APP_KEY=
DB_DATABASE=landing
DB_USERNAME=landing
DB_PASSWORD=
ADMIN_PATH=
